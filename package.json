{
  "name": "9router-cli",
  "version": "0.1.0",
  "private": false,
  "description": "CLI for the 9router admin API (combos, providers, models, probe)",
  "bin": {
    "9router-cli": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "bun scripts/build.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@typescript/native-preview": "^7.0.0-dev.20260427.1",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
